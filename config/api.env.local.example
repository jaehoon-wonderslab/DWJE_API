# =====================================================================================
#  덕우전자 AX 시스템 API — 로컬(개발자 PC) 환경변수 예시 (api.env.local.example)
#
#  사용법
#  ------
#    cp config/api.env.local.example config/api.env.local
#    ./start.sh --profile=local
#
#  start.sh 는 --profile=<이름> 이 주어지면 config/api.env.<이름> 을 먼저 찾고,
#  없으면 config/api.env 로 떨어집니다. 따라서 로컬 기동 시에는 반드시
#  --profile=local 을 붙이십시오.
#
#  [중요] 운영 비밀번호(PROD_*)는 이 파일에 넣지 마십시오.
#         운영값은 실서버의 config/api.env 에만 둡니다. 한 파일에 섞으면
#         노트북에서 ./start.sh 를 그냥 실행했을 때 "운영 비밀번호로 로컬 DB 접속"
#         이 되어 전 API 가 500(FATAL: password authentication failed)이 됩니다.
# =====================================================================================

# 1. 활성 프로파일 — 로컬 고정
APP_PROFILE=local

# 2. 서비스 포트
PORT=8080

# 3. 로컬 PostgreSQL (docker 컨테이너 dwje-pg)
#    application-local.yml 이 localhost:5432/dwjedb · 계정 dwje_local 로 접속합니다.
#    비워 두면 기본값 dwje_local 이 쓰입니다.
LOCAL_DB_PASSWORD="dwje_local"

# 4. AOI 원천 (MSSQL EDGE) — 사내망 또는 VPN 연결 시에만 응답합니다.
#    비우면 /api/v1/quality/aoi/* 는 SOURCE_NOT_CONFIGURED(E-SOURCE-001)로 응답합니다.
AX_MSSQL_URL="jdbc:sqlserver://<MSSQL_HOST>:1433;databaseName=EDGE;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=false"
AX_MSSQL_USER="<계정>"
AX_MSSQL_PASSWORD="<비밀번호>"

# 5. JVM 옵션 — 노트북 기준. 운영(-Xmx4g)보다 낮춰 둡니다.
JAVA_OPTS="-Xms512m -Xmx2g -XX:+UseG1GC -Duser.timezone=Asia/Seoul -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"

# 6. LLM — case1 기본값 (Mac 로컬 DB + 기존 OpenAI 호환 서버)
DWJE_LLM_BASE_URL=http://wddg.ddns.net:11435
DWJE_LLM_MODEL=dwje-ax
# DWJE_LLM_TIMEOUT_MS=120000
#    대시보드 AI(브리핑·원인 분석)의 API 형식도 OpenAI 호환입니다. 구형 Ollama 를 쓸 때만 ollama 로 바꿉니다.
DWJE_LLM_PROVIDER=openai
# case2 (Mac 로컬 DB + 내부 게이트웨이)로 쓸 때 위 주소만 다음 값으로 바꿉니다.
#    GPU 서버 vLLM(사내망·VPN) 을 쓸 때 — 채팅 :8000, 임베딩 :8001(OpenAI 형식)
# DWJE_LLM_BASE_URL=http://192.168.2.8:8000
# AX_EMBED_BASE_URL=http://192.168.2.8:8001
# AX_EMBED_MODEL=BAAI/bge-m3
# AX_EMBED_API=openai
#    문서 임베딩 — 기본은 DWJE_LLM_BASE_URL 과 같은 서버(로컬 Ollama 형식). 실패하면 원인 분석은 키워드 검색으로 대신합니다
# AX_EMBED_BASE_URL=

# --- 메일 실제 발송(선택, R-17) ---
# 기본은 LOG 모드(인증 코드를 로그로, 고정 코드 000000). AX_MAIL_SENDER_MODE=SMTP 로 띄우면 아래 값으로 실제 발송하고
# 고정 코드·발송 상한 해제가 꺼진다. 시험 메일은 발신 계정 자신에게만 보낸다(직원 주소 금지).
# AX_MAIL_SENDER_MODE=SMTP
# LOCAL_MAIL_HOST=smtp.example.com
# LOCAL_MAIL_PORT=465
# LOCAL_MAIL_USERNAME=your_mail_account@example.com
# LOCAL_MAIL_PASSWORD=your_mail_password_here
# LOCAL_MAIL_FROM=your_mail_account@example.com
