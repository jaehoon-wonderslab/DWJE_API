# =====================================================================================
#  덕우전자 AX 시스템 API (dwje-api) — 운영 환경변수 설정 템플릿
#
#  배포 서버에서 이 파일을 config/api.env 로 복사한 뒤 실제 운영 값을 입력하십시오.
#  cp config/api.env.example config/api.env
#  chmod 600 config/api.env
#
#  [환경별 파일 분리]
#  start.sh 는 --profile=<이름> 이 주어지면 config/api.env.<이름> 을 먼저 찾고,
#  없으면 이 파일(config/api.env)로 떨어집니다.
#      운영 서버      : config/api.env            → ./start.sh
#      개발자 PC      : config/api.env.local      → ./start.sh --profile=local
#  이 파일은 "운영 전용" 입니다. 로컬 값을 여기에 섞지 마십시오 —
#  노트북에서 ./start.sh 를 그냥 실행하면 운영 비밀번호로 로컬 DB 에 접속하려다
#  전 API 가 500(FATAL: password authentication failed)이 됩니다.
#  로컬 설정은 config/api.env.local.example 를 참고하십시오.
# =====================================================================================

# 1. 프로파일 설정 (prod 또는 dev)
APP_PROFILE=prod

# 2. 서비스 포트 (기본값: 8080)
PORT=8080

# 3. 운영 데이터베이스 (PostgreSQL)
# 배포 서버의 DB 주소로 변경하십시오. localhost 는 API와 DB가 같은 서버일 때 사용합니다.
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/dwjedb"
SPRING_DATASOURCE_USERNAME="dwje_local"
PROD_DB_PASSWORD=your_prod_db_password_here

# 4. JWT 서명 시크릿 키 (RFC 7518 규격: UTF-8 기준 최소 32바이트 / 256비트 이상 필수)
PROD_JWT_SECRET=your_production_jwt_secret_key_minimum_32_bytes_long_123456

# 5. SMTP 메일 발송 설정 (이메일 인증용)
PROD_MAIL_HOST=smtp.office365.com
PROD_MAIL_USERNAME=noreply@dwje.co.kr
PROD_MAIL_PASSWORD=your_mail_password_here

# 6. 파일 저장소 경로 (선택, 기본값: ./data/...)
# AX_UPLOAD_DIR=/opt/dwje/data/ax-uploads

# 7. AOI 치수 원천 (MSSQL EDGE.dbo.TB_SAMSUN_DIMENSION) — /api/v1/quality/aoi/dimension/*
#    주입하지 않으면 해당 API 는 SOURCE_NOT_CONFIGURED(E-SOURCE-001)로 응답합니다.
#    ※ 계정은 저장소에 두지 않습니다. 실서버 api.env 에만 적으십시오.
# AX_MSSQL_URL="jdbc:sqlserver://192.168.7.203:1433;databaseName=EDGE;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=false"
# AX_MSSQL_USER=
# AX_MSSQL_PASSWORD=

# 8. JVM 튜닝 옵션 (운영 서버 사양에 맞게 조정, 기본 2GB~4GB)
JAVA_OPTS="-Xms2g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Duser.timezone=Asia/Seoul -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"

# 9. 사내 LLM 채팅 프록시 (/api/ai/chat · /api/ai/health) — 생략하면 아래 기본값으로 동작합니다.
#    브라우저는 LLM 서버를 직접 부르지 않고 이 API 를 거칩니다. 사내 LAN 주소: http://192.168.219.52:11435
# DWJE_LLM_BASE_URL=http://wddg.ddns.net:11435
# DWJE_LLM_MODEL=dwje-ax
# DWJE_LLM_TIMEOUT_MS=120000
#    LLM 서버에 토큰 인증을 붙이면 채웁니다 — Authorization: Bearer <값>
# DWJE_LLM_API_KEY=
#    대시보드 AI(브리핑·원인 분석)도 같은 서버(dwje-ax, OpenAI 호환)를 씁니다. 예전 로컬 Ollama 는 ollama
# DWJE_LLM_PROVIDER=openai
#    문서 임베딩(bge-m3) 서버 — 기본은 DWJE_LLM_BASE_URL 과 같은 서버. 실패하면 원인 분석은 키워드 검색으로 대신합니다
# AX_EMBED_BASE_URL=
