# =====================================================================================
#  덕우전자 AX 시스템 API (dwje-api) — 운영 환경변수 설정 템플릿
#
#  배포 서버에서 이 파일을 config/api.env 로 복사한 뒤 실제 운영 값을 입력하십시오.
#  cp config/api.env.example config/api.env
#  chmod 600 config/api.env
# =====================================================================================

# 1. 프로파일 설정 (prod 또는 dev)
APP_PROFILE=prod

# 2. 서비스 포트 (기본값: 8080)
PORT=8080

# 3. 운영 데이터베이스 (PostgreSQL)
# 배포 서버의 DB 주소로 변경하십시오. localhost 는 API와 DB가 같은 서버일 때 사용합니다.
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/dwjedb"
SPRING_DATASOURCE_USERNAME="dwje_local"
PROD_DB_PASSWORD=your_prod_db_password_here

# 4. JWT 서명 시크릿 키 (RFC 7518 규격: UTF-8 기준 최소 32바이트 / 256비트 이상 필수)
PROD_JWT_SECRET=your_production_jwt_secret_key_minimum_32_bytes_long_123456

# 5. SMTP 메일 발송 설정 (이메일 인증용)
PROD_MAIL_HOST=smtp.office365.com
PROD_MAIL_USERNAME=noreply@dwje.co.kr
PROD_MAIL_PASSWORD=your_mail_password_here

# 6. 파일 저장소 및 NAS 마운트 경로 (선택, 기본값: ./data/...)
# AX_UPLOAD_DIR=/opt/dwje/data/ax-uploads
# AX_NAS_AOI_ROOT=/mnt/nas/aoi-images

# 7. JVM 튜닝 옵션 (운영 서버 사양에 맞게 조정, 기본 2GB~4GB)
JAVA_OPTS="-Xms2g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Duser.timezone=Asia/Seoul -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8"
