# =====================================================================================
#  사내 개발 서버 환경 템플릿 (application-dev.yml + dev DB)
#
#  최초 1회 config/api.env.dev 로 복사하고 DEV_* 비밀값을 채우십시오.
#  ./start.sh --profile=dev 는 config/api.env.dev 를 읽으며, 기존 파일을 덮어쓰지 않습니다.
# =====================================================================================

APP_PROFILE=dev
PORT=8080

DEV_DB_PASSWORD=your_dev_db_password_here
DEV_JWT_SECRET=replace_with_at_least_32_random_bytes
# SMTP(R-17) — 465 SSL 직접 연결. 발신 주소는 인증 계정과 같아야 한다
DEV_MAIL_HOST=smtp.example.com
DEV_MAIL_PORT=465
DEV_MAIL_USERNAME=your_dev_mail_account
DEV_MAIL_PASSWORD=your_dev_mail_password
DEV_MAIL_FROM=your_dev_mail_account

# case3: 서버 DB + GPU 서버 vLLM(2026-10 전환) — 채팅 :8000, 임베딩 :8001
DWJE_LLM_BASE_URL=http://192.168.2.8:8000
DWJE_LLM_MODEL=dwje-ax
DWJE_LLM_PROVIDER=openai
AX_EMBED_BASE_URL=http://192.168.2.8:8001
AX_EMBED_MODEL=BAAI/bge-m3
AX_EMBED_API=openai
